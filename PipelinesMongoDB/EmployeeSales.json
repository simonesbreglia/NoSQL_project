[
  {
    "$match": {
      "SupportRepId": {
        "$in": [
          3
        ]
      }
    }
  },
  {
    "$unwind": "$InvoiceLines"
  },
  {
    "$project": {
      "_id": 0,
      "EmployeeId": "$SupportRepId",
      "InvoiceDate": "$InvoiceDate",
      "TotalRevenue": {
        "$multiply": [
          "$InvoiceLines.UnitPrice",
          "$InvoiceLines.Quantity"
        ]
      }
    }
  },
  {
    "$group": {
      "_id": {
        "EmployeeId": "$EmployeeId",
        "InvoiceDate": "$InvoiceDate"
      },
      "TotalRevenue": {
        "$sum": "$TotalRevenue"
      }
    }
  },
  {
    "$project": {
      "_id": 0,
      "EmployeeId": "$_id.EmployeeId",
      "InvoiceDate": "$_id.InvoiceDate",
      "TotalRevenue": 1
    }
  }
]