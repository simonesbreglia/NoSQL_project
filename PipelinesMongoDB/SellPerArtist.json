[
  {
    "$match": {
      "InvoiceLines.TrackId": {
        "$in": []
      }
    }
  },
  {
    "$unwind": "$InvoiceLines"
  },
  {
    "$lookup": {
      "from": "Track",
      "localField": "InvoiceLines.TrackId",
      "foreignField": "Track.TrackId",
      "as": "TrackVec"
    }
  },
  {
    "$project": {
      "InvoiceId": 1,
      "_id": 0,
      "ArtistName": "$TrackVec.Artist.Name",
      "TotalRevenue": {
        "$multiply": [
          "$InvoiceLines.UnitPrice",
          "$InvoiceLines.Quantity"
        ]
      }
    }
  },
  {
    "$group": {
      "_id": "$ArtistName",
      "TotalRevenue": {
        "$sum": "$TotalRevenue"
      }
    }
  },
  {
    "$sort": {
      "TotalRevenue": -1
    }
  }
]