[
{"$unwind": "$InvoiceLines"},
{
    "$lookup": {
        "from": "Track",
        "localField": "InvoiceLines.TrackId",
        "foreignField": "Track.TrackId",
        "as": "TrackVec"
    }
},
{
    "$project": {
        "InvoiceId": 1,
        "_id": 0,
        "AlbumName": "$TrackVec.Album.Title",
        "TotalRevenue": {
                "$multiply": ["$InvoiceLines.UnitPrice", "$InvoiceLines.Quantity"]
        }
    }
},
{
    "$group": {
        "_id": "$AlbumName",
        "TotalRevenue": {"$sum": "$TotalRevenue" }
    }
},
{
    "$sort": {
        "TotalRevenue": -1
    }
}
]